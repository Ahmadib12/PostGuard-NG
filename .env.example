HOST=127.0.0.1
PORT=8000
APP_ENV=development
POSTGUARD_DEPLOYMENT_MODE=customer_hosted
POSTGUARD_ORGANIZATION_ID=default
# Optional server-side mapping; do not accept organization IDs from request headers or bodies.
# POSTGUARD_CLIENT_ORGANIZATIONS={"demo-client":"default","partner-x":"default"}
DEBUG=false

MOCK_NIPOST=true
NIPOST_BASE_URL=https://api.postcode.gov.ng
NIPOST_API_KEY=replace-with-your-live-key-if-using-live-mode
MAX_UPSTREAM_RESPONSE_BYTES=1048576
REDIS_URL=redis://localhost:6379/0
DASHBOARD_DATABASE_URL=sqlite:///./postguard_dashboard.db
TRUSTED_HOSTS=localhost,127.0.0.1
# Comma-separated trusted reverse-proxy IPs/CIDRs. Compose configures its dashboard proxy.
TRUSTED_PROXIES=

# Configure a separate administrator account; never reuse a client HMAC secret.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_FILE=.admin-bootstrap-credential
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_COOKIE_SECURE=false
ADMIN_LOGIN_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=900

# Optional OpenAI-compatible incident investigation; disabled by default.
INTELLIGENCE_ENABLED=false
INTELLIGENCE_BASE_URL=https://api.openai.com/v1
INTELLIGENCE_API_KEY=
INTELLIGENCE_MODEL=
INTELLIGENCE_TIMEOUT_SECONDS=15

POSTGUARD_DEMO_CLIENT_SECRET=replace-with-at-least-32-bytes-of-random-data
POSTGUARD_PARTNER_X_SECRET=replace-with-at-least-32-bytes-of-random-data

MAX_CLOCK_SKEW_SECONDS=120
NONCE_TTL_SECONDS=300
REQUEST_TTL_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=16384
