HOST=0.0.0.0
PORT=8000
DEBUG=false

MOCK_NIPOST=true
NIPOST_BASE_URL=https://api.postcode.gov.ng
NIPOST_API_KEY=replace-with-your-live-key-if-using-live-mode
REDIS_URL=redis://localhost:6379/0

POSTGUARD_DEMO_CLIENT_SECRET=replace-with-at-least-32-bytes-of-random-data
POSTGUARD_PARTNER_X_SECRET=replace-with-at-least-32-bytes-of-random-data

MAX_CLOCK_SKEW_SECONDS=120
NONCE_TTL_SECONDS=300
REQUEST_TTL_SECONDS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=16384
