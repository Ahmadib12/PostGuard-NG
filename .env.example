# PostGuard NG environment configuration
# Copy this file to .env and replace the placeholder values with real ones.

HOST=0.0.0.0
PORT=8000
DEBUG=false

# Required security settings
POSTGUARD_CLIENT_SECRET=replace-with-your-secret
NIPOST_API_KEY=replace-with-your-nipost-api-key
REDIS_URL=redis://localhost:6379/0

# Optional tuning
MAX_CLOCK_SKEW_SECONDS=120
NONCE_TTL_SECONDS=300
REQUEST_TTL_SECONDS=120
RATE_LIMIT_PER_MINUTE=10
